@model ScheduleEditViewModel
@{
    ViewData["Title"] = "Edit Schedule";
}

<h2>Edit Schedule — @Model.EmployeeName</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.ScheduleId" method="post">
            <input type="hidden" asp-for="ScheduleId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ShiftDate" class="form-label"></label>
                <input asp-for="ShiftDate" class="form-control" />
                <span asp-validation-for="ShiftDate" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="StartTime" class="form-label"></label>
                <input asp-for="StartTime" class="form-control" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="EndTime" class="form-label"></label>
                <input asp-for="EndTime" class="form-control" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes" class="form-control"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

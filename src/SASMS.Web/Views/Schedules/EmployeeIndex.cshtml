@model List<Schedule>
@{
    ViewData["Title"] = "My Schedule";
}

<h2>My Schedule</h2>

<div class="card">
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <partial name="_EmptyState" model="@("No shifts scheduled for you yet.")" />
        }
        else
        {
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead><tr><th>Date</th><th>Start</th><th>End</th><th>Notes</th></tr></thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.ShiftDate.ToString("dd/MM/yy")</td>
                            <td>@s.StartTime</td>
                            <td>@s.EndTime</td>
                            <td>@s.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        }
    </div>
</div>

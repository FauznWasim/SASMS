@model List<OvertimeRow>
@{
    ViewData["Title"] = "Overtime Report";
    DateOnly from = ViewBag.From;
    DateOnly to = ViewBag.To;
}

<h2>Overtime Report</h2>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-auto"><div class="date-field"><input type="date" name="from" class="form-control date-field-native visually-hidden" value="@from.ToString("yyyy-MM-dd")" /><input type="text" class="form-control date-field-text" readonly placeholder="DD/MM/YY" /></div></div>
            <div class="col-auto"><div class="date-field"><input type="date" name="to" class="form-control date-field-native visually-hidden" value="@to.ToString("yyyy-MM-dd")" /><input type="text" class="form-control date-field-text" readonly placeholder="DD/MM/YY" /></div></div>
            <div class="col-auto"><button type="submit" class="btn btn-outline-primary">View</button></div>
            <div class="col-auto"><a class="btn btn-outline-secondary" asp-action="OvertimeExport" asp-route-from="@from" asp-route-to="@to">Export CSV</a></div>
        </form>

        @if (Model.Count == 0)
        {
            <partial name="_EmptyState" model="@("No overtime records for this date range.")" />
        }
        else
        {
        <table class="table table-striped mb-0">
            <thead><tr><th>Employee</th><th>Date</th><th>Hours Worked</th><th>Overtime Hours</th></tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>@r.EmployeeName</td>
                        <td>@r.AttendanceDate.ToString("dd/MM/yy")</td>
                        <td>@r.HoursWorked.ToString("0.##")</td>
                        <td>@r.OvertimeHours.ToString("0.##")</td>
                    </tr>
                }
            </tbody>
        </table>
        }
    </div>
</div>

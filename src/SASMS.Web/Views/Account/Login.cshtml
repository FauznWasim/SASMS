@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["BodyClass"] = "login-page";
}

<div class="login-card">
    <img class="login-card__logo" src="~/images/subway-logo.png" asp-append-version="true" alt="SASMS" />

    <h2 class="login-card__title">Welcome Back</h2>
    <p class="login-card__subtitle">Sign in to manage attendance and shifts</p>

    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3 text-start">
            <label asp-for="Username" class="form-label"></label>
            <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="mb-3 text-start">
            <label asp-for="Password" class="form-label"></label>
            <div class="input-group">
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <partial name="_PasswordToggleButton" />
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">Log in</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

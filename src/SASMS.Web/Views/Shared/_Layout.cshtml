@using System.Security.Claims
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - SASMS</title>
    <!-- Read by wwwroot/js/face-capture.js so its fetch() JSON posts can carry a valid
         antiforgery token as a header (no <form> to hold a hidden input in that flow). -->
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />

    <!-- PWA installability foundation — manifest + iOS Add to Home Screen metadata only;
         deliberately no service worker (no offline caching of any page, authenticated or
         otherwise). -->
    <link rel="manifest" href="~/manifest.webmanifest" asp-append-version="true" />
    <meta name="theme-color" content="#00543c" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="SASMS" />
    <link rel="apple-touch-icon" href="~/images/icons/apple-touch-icon-180.png" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    <header>
        <nav class="navbar navbar-expand-sm navbar-sasms border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <img src="~/images/subway-logo.png" asp-append-version="true" alt="" height="34" />
                    SASMS
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Attendance" asp-action="Index">Attendance</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Schedules" asp-action="Index">Schedules</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Leave" asp-action="Index">Leave</a></li>
                            @if (User.IsInRole(SASMS.Web.Security.RoleNames.Manager))
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Employees" asp-action="Index">Employees</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a></li>
                            }
                        </ul>
                        <ul class="navbar-nav align-items-sm-center mt-2 mt-sm-0">
                            <li class="nav-item">@await Component.InvokeAsync("NotificationBell")</li>
                            <li class="nav-item">
                                <span class="nav-link">@User.Identity!.Name (@User.FindFirst(ClaimTypes.Role)?.Value)</span>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="ChangePassword">Change Password</a></li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link">Logout</button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container site-main">
        <main role="main" class="pb-3">
            @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    @statusMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="footer-sasms">
        <div class="container footer-bottom">
            <span>&copy; @DateTime.Now.Year Secure Attendance and Shift Management System &middot; FYP4124 &middot; Faculty of Computing &amp; Multimedia</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

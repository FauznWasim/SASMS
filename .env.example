# Copy this file to `.env` (same folder as docker-compose.yml) and fill in real values.
# `.env` itself is gitignored — never commit it. docker-compose.yml reads these
# automatically; nothing here is baked into any image.

# --- MySQL application account (NOT root) -----------------------------------------------
# Generate strong random values, e.g.: openssl rand -base64 24
MYSQL_APP_USER=sasms_app
MYSQL_APP_PASSWORD=change-me-to-a-long-random-value

# --- Shared secrets -----------------------------------------------------------------------
# FACE_SERVICE_SHARED_SECRET and the web container's FaceVerificationService__SharedSecret
# (set from this same value in docker-compose.yml) MUST be identical — this is the
# shared-secret header auth between the ASP.NET Core app and the Python face-service.
# Generate with, e.g.: openssl rand -hex 32
FACE_SERVICE_SHARED_SECRET=change-me-face-service-secret

# Shared secret for the separate POST /api/verification/callback endpoint (an external/
# decoupled-caller seam, not used by the interactive check-in/out flow itself — see
# Api/VerificationController.cs). Generate the same way.
VERIFICATION_SERVICE_SHARED_SECRET=change-me-verification-callback-secret
